{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./",
    "baseUrl": "./",
    "paths": {
      "@core/*": ["src/core/*"],
      "@parser/*": ["src/parser/*"],
      "@adapter/*": ["src/adapter/*"],
      "@listeners/*": ["src/listeners/*"],
      "@orchestrator/*": ["src/orchestrator/*"],
      "@config/*": ["src/config/*"],
      "@legacy/*": ["src/legacy/*"],
      "@/*": ["src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "generated/**/*"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "test",
    "grammar"
  ],
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
